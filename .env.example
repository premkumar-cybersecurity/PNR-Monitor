PORT=3000

# Supabase
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# PNR provider
PNR_API_URL=https://api.apimitra.in/train/pnr
PNR_API_KEY=YOUR_PNR_API_KEY
PNR_PROVIDER_ENABLED=true

# Email notifications
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=PNR Monitor <onboarding@resend.dev>

# Optional: public URL used for the email button
APP_URL=https://YOUR-APP.onrender.com
